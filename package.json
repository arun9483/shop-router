{
  "name": "shop-router",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps --import newrelic/esm-loader.mjs -r newrelic dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.3.0",
    "http-proxy-middleware": "4.2.0",
    "newrelic": "14.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/newrelic": "9.14.8",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11.28.5"
  }
}

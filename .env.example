PORT=3000
SHELL_URL=http://localhost:3001
# One variable per MFE. Point one at another build to swap that MFE without touching the Shell.
MFE_CATALOG_URL=http://localhost:3002
MFE_CART_URL=http://localhost:3003
# The router's health and version endpoints are public and on by default. false turns them off.
HEALTH_ENDPOINTS_ENABLED=true
# How long one FES may take to answer /health/units. Raise it where units sleep when idle.
HEALTH_UNIT_TIMEOUT_MS=1000

# New Relic Node agent, on by default. NEW_RELIC_ENABLED=false turns it off. The license key is a
# placeholder.
NEW_RELIC_ENABLED=true
NEW_RELIC_LICENSE_KEY=dummy-new-relic-license-key
NEW_RELIC_APP_NAME=shop-router
NEW_RELIC_NO_CONFIG_FILE=true
NEW_RELIC_LOG=stdout
NEW_RELIC_LOG_LEVEL=warn
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# Only API calls are traced: everything that is not under /api/ is left out of New Relic transactions.
NEW_RELIC_IGNORING_RULES=^/(?!api/)
# A 500 comes from a unit and is reported by it. The router's own failures are 502 and 504.
NEW_RELIC_ERROR_COLLECTOR_IGNORE_ERROR_CODES=404,500
# Keep the whole trace when the caller (the browser) kept it.
NEW_RELIC_DISTRIBUTED_TRACING_SAMPLER_REMOTE_PARENT_SAMPLED=always_on
# Local only: skip the agent's cloud host checks, which fail off-cloud and log errors at start.
NEW_RELIC_UTILIZATION_DETECT_AWS=false
NEW_RELIC_UTILIZATION_DETECT_AZURE=false
NEW_RELIC_UTILIZATION_DETECT_GCP=false
